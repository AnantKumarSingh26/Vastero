# Dependencies
node_modules/
jspm_packages/
web_modules/

# Debugging logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data and locks
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (Crashed Node processes)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Testing and Coverage
coverage/
.nyc_output
.jest/

# Build and Output directories
dist/
build/
.next/
.nuxt/
.out/
.cache/

# Environment variables and secrets (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
! .env.example

# TypeScript cache
*.tsbuildinfo

# Optional: IDE and OS-specific files (Can also be ignored globally)
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
